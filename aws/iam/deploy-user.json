{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": [
        "lambda:UpdateFunctionCode",
        "lambda:GetFunction",
        "lambda:GetFunctionConfiguration"
      ],
      "Resource": [
        "arn:aws:lambda:us-east-2:ACCOUNT_ID:function:pbj-processor",
        "arn:aws:lambda:us-east-2:ACCOUNT_ID:function:pbj-admin"
      ]
    },
    {
      "Effect": "Allow",
      "Action": [
        "s3:PutObject"
      ],
      "Resource": "arn:aws:s3:::pbj-preview-jm26/*"
    }
  ]
}
