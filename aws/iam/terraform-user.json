
{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": ["s3:ListBucket"],
      "Resource": "arn:aws:s3:::pbj-data-jm26",
      "Condition": {
        "StringLike": {
          "s3:prefix": [
            "terraform/pbj.tfstate",
            "terraform/pbj.tfstate.tflock"
          ]
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject"],
      "Resource": "arn:aws:s3:::pbj-data-jm26/terraform/pbj.tfstate"
    },
    {
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject", "s3:DeleteObject"],
      "Resource": "arn:aws:s3:::pbj-data-jm26/terraform/pbj.tfstate.tflock"
    },
    {
      "Effect": "Allow",
      "Action": [
        "iam:CreateRole", "iam:GetRole", "iam:UpdateAssumeRolePolicy",
        "iam:UpdateRole", "iam:PutRolePolicy", "iam:GetRolePolicy",
        "iam:ListRolePolicies", "iam:ListAttachedRolePolicies",
        "iam:ListInstanceProfilesForRole", "iam:ListRoleTags",
        "iam:TagRole", "iam:UntagRole"
      ],
      "Resource": [
        "arn:aws:iam::ACCOUNT_ID:role/pbj-lambda-execution",
        "arn:aws:iam::ACCOUNT_ID:role/pbj-scheduler-execution",
        "arn:aws:iam::ACCOUNT_ID:role/pbj-admin-execution"
      ]
    },
    {
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": [
        "arn:aws:iam::ACCOUNT_ID:role/pbj-lambda-execution",
        "arn:aws:iam::ACCOUNT_ID:role/pbj-admin-execution"
      ],
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": "lambda.amazonaws.com"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": [
        "lambda:CreateFunction", "lambda:GetFunction",
        "lambda:GetFunctionConfiguration", "lambda:UpdateFunctionConfiguration",
        "lambda:GetFunctionCodeSigningConfig", "lambda:GetPolicy",
        "lambda:ListVersionsByFunction", "lambda:GetFunctionConcurrency",
        "lambda:GetRuntimeManagementConfig", "lambda:ListTags",
        "lambda:TagResource", "lambda:UntagResource",
        "lambda:PutFunctionConcurrency", "lambda:AddPermission",
        "lambda:RemovePermission"
      ],
      "Resource": [
        "arn:aws:lambda:us-east-2:ACCOUNT_ID:function:pbj-processor",
        "arn:aws:lambda:us-east-2:ACCOUNT_ID:function:pbj-admin"
      ]
    },
    {
      "Effect": "Allow",
      "Action": ["logs:DescribeLogGroups"],
      "Resource": "*"
    },
    {
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogGroup", "logs:PutRetentionPolicy",
        "logs:DeleteRetentionPolicy", "logs:ListTagsLogGroup",
        "logs:ListTagsForResource", "logs:TagResource",
        "logs:UntagResource"
      ],
      "Resource": [
        "arn:aws:logs:us-east-2:ACCOUNT_ID:log-group:/aws/lambda/pbj-processor",
        "arn:aws:logs:us-east-2:ACCOUNT_ID:log-group:/aws/lambda/pbj-processor:*",
        "arn:aws:logs:us-east-2:ACCOUNT_ID:log-group:/aws/lambda/pbj-admin",
        "arn:aws:logs:us-east-2:ACCOUNT_ID:log-group:/aws/lambda/pbj-admin:*"
      ]
    },
    {
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::ACCOUNT_ID:role/pbj-scheduler-execution",
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": "scheduler.amazonaws.com"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": [
        "scheduler:CreateSchedule", "scheduler:GetSchedule",
        "scheduler:UpdateSchedule"
      ],
      "Resource": [
        "arn:aws:scheduler:us-east-2:ACCOUNT_ID:schedule/default/pbj-create-week",
        "arn:aws:scheduler:us-east-2:ACCOUNT_ID:schedule/default/pbj-poll-games"
      ]
    },
    {
      "Effect": "Allow",
      "Action": [
        "s3:CreateBucket", "s3:GetBucketLocation", "s3:ListBucket",
        "s3:GetBucketPolicy", "s3:PutBucketPolicy",
        "s3:GetBucketPublicAccessBlock", "s3:PutBucketPublicAccessBlock",
        "s3:GetBucketTagging", "s3:PutBucketTagging",
        "s3:GetBucketAcl", "s3:GetBucketCors", "s3:GetBucketWebsite",
        "s3:GetBucketVersioning", "s3:GetAccelerateConfiguration",
        "s3:GetBucketRequestPayment", "s3:GetBucketLogging",
        "s3:GetLifecycleConfiguration", "s3:GetReplicationConfiguration",
        "s3:GetEncryptionConfiguration",
        "s3:GetBucketObjectLockConfiguration",
        "s3:GetBucketOwnershipControls"
      ],
      "Resource": "arn:aws:s3:::pbj-preview-jm26"
    },
    {
      "Effect": "Allow",
      "Action": ["s3:GetBucketPolicy", "s3:PutBucketPolicy"],
      "Resource": "arn:aws:s3:::pbj-data-jm26"
    },
    {
      "Effect": "Allow",
      "Action": [
        "cloudfront:CreateDistribution",
        "cloudfront:CreateOriginAccessControl",
        "cloudfront:CreateResponseHeadersPolicy",
        "cloudfront:CreateFunction"
      ],
      "Resource": "*"
    },
    {
      "Effect": "Allow",
      "Action": [
        "cloudfront:GetDistribution",
        "cloudfront:GetDistributionConfig",
        "cloudfront:UpdateDistribution",
        "cloudfront:ListTagsForResource",
        "cloudfront:TagResource", "cloudfront:UntagResource"
      ],
      "Resource": "arn:aws:cloudfront::ACCOUNT_ID:distribution/PREVIEW_DISTRIBUTION_ID"
    },
    {
      "Effect": "Allow",
      "Action": [
        "cloudfront:GetOriginAccessControl",
        "cloudfront:UpdateOriginAccessControl"
      ],
      "Resource": "arn:aws:cloudfront::ACCOUNT_ID:origin-access-control/PREVIEW_OAC_ID"
    },
    {
      "Effect": "Allow",
      "Action": [
        "cloudfront:GetResponseHeadersPolicy",
        "cloudfront:UpdateResponseHeadersPolicy"
      ],
      "Resource": "arn:aws:cloudfront::ACCOUNT_ID:response-headers-policy/PREVIEW_HEADERS_POLICY_ID"
    },
    {
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject", "s3:GetObjectTagging"],
      "Resource": "arn:aws:s3:::pbj-preview-jm26/assets/admin-config.json"
    },
    {
      "Effect": "Allow",
      "Action": [
        "cloudfront:DescribeFunction", "cloudfront:GetFunction",
        "cloudfront:UpdateFunction", "cloudfront:PublishFunction",
        "cloudfront:ListTagsForResource"
      ],
      "Resource": "arn:aws:cloudfront::ACCOUNT_ID:function/pbj-admin-index"
    },
    {
      "Effect": "Allow",
      "Action": [
        "cognito-idp:CreateUserPool",
        "cognito-idp:DescribeUserPoolDomain"
      ],
      "Resource": "*"
    },
    {
      "Effect": "Allow",
      "Action": [
        "cognito-idp:DescribeUserPool",
        "cognito-idp:UpdateUserPool",
        "cognito-idp:GetUserPoolMfaConfig",
        "cognito-idp:SetUserPoolMfaConfig",
        "cognito-idp:ListTagsForResource",
        "cognito-idp:TagResource", "cognito-idp:UntagResource",
        "cognito-idp:CreateUserPoolClient",
        "cognito-idp:DescribeUserPoolClient",
        "cognito-idp:UpdateUserPoolClient",
        "cognito-idp:CreateResourceServer",
        "cognito-idp:DescribeResourceServer",
        "cognito-idp:UpdateResourceServer",
        "cognito-idp:CreateUserPoolDomain",
        "cognito-idp:UpdateUserPoolDomain",
        "cognito-idp:CreateManagedLoginBranding",
        "cognito-idp:DescribeManagedLoginBranding",
        "cognito-idp:UpdateManagedLoginBranding"
      ],
      "Resource": "arn:aws:cognito-idp:us-east-2:ACCOUNT_ID:userpool/ADMIN_POOL_ID"
    },
    {
      "Effect": "Allow",
      "Action": "apigateway:POST",
      "Resource": "arn:aws:apigateway:us-east-2::/apis"
    },
    {
      "Effect": "Allow",
      "Action": [
        "apigateway:GET", "apigateway:POST",
        "apigateway:PATCH", "apigateway:PUT"
      ],
      "Resource": [
        "arn:aws:apigateway:us-east-2::/apis/ADMIN_API_ID/*"
      ]
    }
  ]
}
