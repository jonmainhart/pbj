{
  "name": "pbj",
  "version": "1.0.0",
  "description": "PBJ Dashboard frontend test tooling.",
  "scripts": {
    "test": "npm run test:unit && npm run test:browser",
    "test:unit": "node --test tests/frontend/unit/*.test.js",
    "test:browser": "playwright test",
    "lint": "eslint site/assets tests/frontend eslint.config.js playwright.config.js",
    "build:admin": "tailwindcss -i site/assets/admin-input.css -o site/assets/admin.css --minify"
  },
  "license": "SEE LICENSE IN LICENSE-SCOPE.md",
  "type": "module",
  "private": true,
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/cli": "^4.3.3",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "tailwindcss": "^4.3.3"
  }
}
